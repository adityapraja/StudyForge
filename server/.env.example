# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tracker

# Authentication
JWT_SECRET=change-this-to-a-secure-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# CORS
CLIENT_URL=http://localhost:5173

# Anti-cheat & Session Rules (Numeric defaults)
DAILY_CAP_HOURS=16
MAX_SESSION_HOURS=12
SESSION_XP_CAP_HOURS=4
DEFAULT_STREAK_MINIMUM_MINUTES=15

