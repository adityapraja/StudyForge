{
  "name": "study-forge",
  "version": "1.0.0",
  "description": "Study Habit Tracker monorepo",
  "private": true,
  "scripts": {
    "start": "npm --prefix server start",
    "dev": "npm --prefix server dev",
    "test": "npm --prefix server test",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "db:setup": "npm --prefix server run db:setup",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}

